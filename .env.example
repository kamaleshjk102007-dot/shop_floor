# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
SHOPFLOOR_USERNAME=NOT_CONFIGURED
SHOPFLOOR_PASSWORD=NOT_CONFIGURED
MANAGEMENT_ALERT_EMAIL=management@example.com
MONGODB_SYNC_BASE_URL=https://your-shopfloor-backend.example.com
MONGODB_SYNC_TOKEN=replace-with-a-long-random-token
SYNC_TOKEN=replace-with-the-same-long-random-token
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=management@example.com
SMTP_PASSWORD=use-a-provider-app-password
SMTP_FROM=OCS ShopFloor Alerts <management@example.com>
